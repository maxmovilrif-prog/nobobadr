# ============================================================
#  Nubo - Variables de entorno del BACKEND (PRODUCCION)
#  Copia este archivo a:  deploy/backend.env  y rellena los valores reales.
#  NO subir este archivo a Git.
# ============================================================

# --- MongoDB Atlas (produccion) ---
# La @ de la contrasena va codificada como %40
MONGO_URL=mongodb+srv://badarbox1756_db_user:Ninite%402030@cluster0.6isx6d9.mongodb.net/?appName=Cluster0
DB_NAME=nubo_produccion

# (Opcional) Overrides - el codigo usa OVERRIDE si existe, si no usa MONGO_URL/DB_NAME
MONGO_URL_OVERRIDE=mongodb+srv://badarbox1756_db_user:Ninite%402030@cluster0.6isx6d9.mongodb.net/?appName=Cluster0
DB_NAME_OVERRIDE=nubo_produccion

# --- CORS (dominio de produccion) ---
CORS_ORIGINS=https://noboexpress.com,https://www.noboexpress.com

# --- App base URL (links de emails, reset password, etc.) ---
APP_BASE_URL=https://noboexpress.com

# --- Seguridad ---
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo_aleatorio
ADMIN_RESET_SECRET=CAMBIA_ESTO_tambien

# --- Pagos (Stripe) ---
STRIPE_API_KEY=sk_live_o_test_tu_clave

# --- IA (Emergent LLM Key) ---
EMERGENT_LLM_KEY=tu_emergent_llm_key

# --- Email: Resend ---
RESEND_API_KEY=tu_resend_api_key
SENDER_EMAIL=no-reply@noboexpress.com
SENDER_NAME=Nubo Express

# --- Email: SMTP (Gmail) ---
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail
MAIL_FROM=tu_correo@gmail.com
